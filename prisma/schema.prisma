generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  EN
  ML
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id String @id @default(cuid())

  name String

  phone String? @unique
  email String  @unique

  passwordHash String

  role UserRole @default(CUSTOMER)

  status UserStatus @default(PENDING_VERIFICATION)

  language Language @default(EN)

  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address Address[]

  subscriptions Subscription[]

  @@index([status])
}

model Address {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  label   String
  line1   String
  line2   String?
  city    String
  state   String
  pincode String

  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

model Product {
  id           String              @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  status       ProductStatus       @default(ACTIVE)
  availability ProductAvailability @default(AVAILABLE)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  imageUrl    String?
  status      ProductStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules SubscriptionSchedule[]
  skipDates SubscriptionSkipDate[]

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([userId, status])
}

model SubscriptionSchedule {
  id String @id @default(cuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, dayOfWeek])
  @@index([subscriptionId])
}

model SubscriptionSkipDate {
  id String @id @default(cuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  date   DateTime
  reason String?

  createdAt DateTime @default(now())

  @@unique([subscriptionId, date])
  @@index([subscriptionId])
  @@index([date])
}
